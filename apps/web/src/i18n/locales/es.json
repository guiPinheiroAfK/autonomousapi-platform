    "confianca": {
      "titulo": "Tus datos siguen siendo tuyos.",
      "texto": "La gestión de flotas maneja ubicación, costo y documentos de personas reales. No lo tratamos como un detalle menor.",
      "garantias": {
        "isolamento": { "titulo": "Aislamiento por cuenta", "texto": "Cada suscriptor ve solo su propia flota. Es una regla de base de datos, no una convención de pantalla — ni siquiera un error de interfaz filtra datos de otra empresa." },
        "transito": { "titulo": "Dato de tránsito, nunca de identidad", "texto": "Lo que se convierte en un índice agregado de condición vial es el comportamiento de la vía, no quién pasó por ella. Nada identifica al conductor, vehículo o cliente final." },
        "export": { "titulo": "Extrae tus datos cuando quieras", "texto": "Exportación en CSV en cualquier momento, sin pedir permiso y sin costo. Cancelar la suscripción no bloquea lo que es tuyo." },
