    "espectro": {
      "eyebrow": "How you want to run it",
      "titulo": "Not every fleet wants the same amount of hands-on work.",
      "texto": "Some people want to open the dashboard every day and touch everything. Others just want the finished report with what they need to decide. Both are customers.",
      "paraQuemLabel": "Best for:",
      "cartoes": {
        "auto": {
          "etapa": "You're in control",
          "titulo": "Self-service",
          "texto": "You register, log and track everything. The system calculates cost per km, warns about maintenance and license expiration, and exports whatever you need.",
          "paraQuem": "Small fleets with someone dedicated to running them."
        },
        "acompanhado": {
          "etapa": "Shared",
          "titulo": "Guided",
          "texto": "You run the day-to-day and one of our fleet managers periodically reviews the fleet, flags what's off and helps course-correct.",
          "paraQuem": "Teams with the operation running but no time to watch the data."
        },
        "dedicado": {
          "etapa": "Hands-off",
          "titulo": "Dedicated manager",
          "texto": "One of our fleet managers takes over the routine: logs costs, schedules maintenance, tracks documentation and delivers the monthly closing ready to go.",
          "paraQuem": "Anyone who wants results without building internal structure."
        }
      }
    },
    "tese": {
      "eyebrow": "Why we built this",
      "titulo": "No generic map knows what it means for a motorbike to weave between two cars stopped at a light.",
      "p1": "Self-driving companies looking at Brazil don't have real data about our traffic. Inconsistent signage, lane markings that disappear, behavior no model trained abroad ever predicted.",
      "p2": "That data isn't collected by test cars driving around empty. It's already being produced, every day, by whoever delivers, transports and rents — nobody's just keeping it.",
      "p3": "Fleet management is a complete product on its own. The real-traffic map is what it leaves behind while it works.",
      "mapaLegenda": "Route logged by the driver's app",
      "mapaEmBreve": "coming soon: real video"
    },
    "recursos": {
      "eyebrow": "What the dashboard already does",
      "titulo": "Six things that probably live in a spreadsheet today.",
      "itens": {
        "custo": { "titulo": "Automatic cost per km", "texto": "Every entry becomes a traceable line item — no parallel spreadsheet, no retyping at month's end." },
        "alerta": { "titulo": "Maintenance and license alerts", "texto": "The system warns before something expires — maintenance or paperwork — not after it already has." },
        "export": { "titulo": "Export with no lock-in", "texto": "Everything exports to CSV whenever you want. The data is yours; the tool is just where it lives while you're with us." },
        "unidades": { "titulo": "Multiple locations", "texto": "One fleet across three cities, or three separate fleets — the dashboard consolidates without mixing what shouldn't mix." },
        "api": { "titulo": "API access", "texto": "If you already have an internal system, integrate whatever you need without rebuilding what AutonomousAPI already solves." },
        "gestor": { "titulo": "Manager on demand", "texto": "Start on your own and ask for help only when it makes sense — the plan grows with you instead of locking you into an early choice." }
      }
    },
    "confianca": {
      "titulo": "Your data stays yours.",
      "texto": "Fleet management deals with the location, cost and documents of real people. We don't treat that as a footnote.",
      "garantias": {
        "isolamento": { "titulo": "Isolated by account", "texto": "Each subscriber sees only their own fleet. It's a database rule, not a screen convention — even a UI bug can't leak another company's data." },
        "transito": { "titulo": "Traffic data, never identity", "texto": "What becomes an aggregate road-condition index is how the road behaves, not who drove on it. Nothing identifies a driver, vehicle or end client." },
        "export": { "titulo": "Take your data out anytime", "texto": "CSV export whenever you want, no permission needed and no fee. Cancelling your subscription doesn't lock away what's yours." },
        "instalacao": { "titulo": "No install, no intrusion", "texto": "There's no hardware to install in the vehicle. The driver's app only logs a route with explicit consent, given at every opening." }
      }
    },
    "planos": {
      "titulo": "Plans",
      "subtitulo": "Priced per active vehicle. You pay for what's on the road, not per seat or per license.",
      "porVeiculoMes": "per vehicle/month",
      "rodape": "Launch pricing. No lock-in contracts and no hardware to install in the vehicle.",
      "starter": {
        "nome": "Starter", "faixa": "1 to 10 vehicles", "preco": "R$ 66", "nota": "R$ 56 on the annual plan", "acao": "Get started",
        "recursos": ["Vehicle and driver registration", "Cost per km and history", "Maintenance and license alerts", "CSV export", "Driver app"]
      },
      "growth": {
        "nome": "Growth", "faixa": "11 to 50 vehicles", "preco": "R$ 58", "nota": "R$ 49 on the annual plan", "heranca": "Everything in Starter, plus:", "acao": "Get started",
        "recursos": ["Service orders", "Consolidated reports", "Multiple locations"]
      },
      "scale": {
        "nome": "Scale", "faixa": "51 to 200 vehicles", "preco": "R$ 49", "nota": "R$ 42 on the annual plan", "heranca": "Everything in Growth, plus:", "acao": "Get started",
        "recursos": ["Periodic review by a fleet manager", "API access", "Priority support"]
      },
      "dedicado": {
        "nome": "Dedicated manager", "faixa": "Operation run by us", "preco": "By quote", "unidade": "depends on fleet size", "heranca": "Everything in Scale, plus:", "acao": "Talk to us",
        "recursos": ["A manager running the routine", "Cost entries logged on your behalf", "Maintenance scheduling", "Monthly closing delivered ready"]
      }
    },
    "perguntas": {
      "titulo": "FAQ",
      "itens": [
        { "q": "Do I need to install a tracker in the vehicles?", "a": "No. The operation is logged through the driver's app, which already runs on their phone. If you want route precision, the app collects the trip while it happens, always with explicit consent given on first open." },
        { "q": "What exactly is \"cost per km\"?", "a": "Every entry you log — fuel, maintenance, tolls — is summed and divided by that vehicle's mileage. You can export everything to CSV and check it against your own spreadsheet; no number appears without you being able to reconstruct it." },
        { "q": "How does the dedicated manager work?", "a": "One of our fleet managers takes over the routine that eats your time today: logs costs, schedules maintenance, tracks document expiration and delivers the month's closing. Price varies with fleet size and how deep the follow-up goes — that's why it's by quote." },
        { "q": "What do you do with my operation's data?", "a": "Your fleet's data is yours and stays isolated by account. Derived traffic data (how a road behaves at a given time) can feed, in aggregated and anonymized form, a road-conditions index — never in a way that identifies your company, your drivers or your clients." },
        { "q": "Is there a contract or cancellation fee?", "a": "No. The plan is monthly and you can cancel whenever you want. The annual plan gives a discount, it doesn't lock you in." }
      ]
    },
    "rodape": { "direitos": "© {{ano}} AutonomousAPI. All rights reserved." }
