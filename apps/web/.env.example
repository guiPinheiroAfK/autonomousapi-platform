# URL do core-api para o proxy de dev do Vite. O web fala SÓ com o core-api.
VITE_CORE_API_URL=http://localhost:8080

# Login/cadastro com Google (Google Identity Services). Vazio por padrão — o botão some da
# tela até isso ser preenchido (mesmo padrão de degradação do Stripe/Resend no backend).
# O Client ID NÃO é segredo (vai pro bundle do front de propósito, é assim que o fluxo de
# ID token do GIS funciona) — client secret nenhum é necessário nem deve existir aqui.
# Criar em https://console.cloud.google.com/apis/credentials, tipo "Web application", com
# a URL do front (dev e prod) em "Authorized JavaScript origins".
#
# Em produção (Netlify), esta variável precisa ser configurada nas env vars do site — o
# Vite embute o valor no build, não lê isso em runtime.
VITE_GOOGLE_CLIENT_ID=
