# Copie para infra/.env e ajuste. NÃO commitar o .env real (spec 04: segredos no secrets manager).
# Os valores default do compose servem para dev local; sobrescreva aqui se quiser.

# Token de serviço compartilhado entre core-api e geo-api (precisa ser IGUAL nos dois).
GEO_SERVICE_TOKEN=dev-service-token-change-me

# Segredo de assinatura do JWT do core-api (mínimo 32 bytes).
CORE_JWT_SECRET=dev-only-secret-change-me-please-0123456789abcdef
