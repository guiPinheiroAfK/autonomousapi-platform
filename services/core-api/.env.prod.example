# Copie para .env.prod na VM (nunca commitar o .env.prod de verdade) e preencha.

# Neon — connection string DIRETA (sem "-pooler" no host). Pega em: Neon console >
# seu projeto > Connection Details > desmarcar "Pooled connection".
CORE_DB_URL=jdbc:postgresql://<seu-endpoint>.<região>.aws.neon.tech/neondb?sslmode=require
CORE_DB_USER=neondb_owner
CORE_DB_PASSWORD=

# Gere um valor aleatório de verdade — NÃO reaproveite o default de dev.
# PowerShell: [Convert]::ToBase64String((1..48 | %{Get-Random -Max 256}))
CORE_JWT_SECRET=

GEO_SERVICE_TOKEN=

# URL pública do apps/web no Netlify (usada em e-mails de convite/reset de senha).
WEB_APP_URL=https://<seu-site>.netlify.app

# Opcional — sem isso, o link de confirmação de e-mail só aparece no log
# (docker compose logs core-api), sem enviar de verdade. Provedor recomendado:
# Resend (3000 e-mails grátis/mês) — passo a passo em docs/setup-email-resend.md.
MAIL_SMTP_HOST=smtp.resend.com
MAIL_SMTP_PORT=587
# Literalmente a palavra "resend", não é placeholder — é a credencial SMTP deles.
MAIL_SMTP_USER=resend
# Sua API key do Resend (começa com "re_").
MAIL_SMTP_PASSWORD=
# Sem domínio verificado no Resend, use onboarding@resend.dev (só entrega no seu
# próprio e-mail de conta Resend). Com domínio verificado, troque por ele.
MAIL_FROM=onboarding@resend.dev

# Opcional — login/cadastro com Google. Sem isso, o botão simplesmente não aparece no
# front (precisa da MESMA chave em VITE_GOOGLE_CLIENT_ID no Netlify, ver
# apps/web/.env.example). Criar em console.cloud.google.com/apis/credentials, tipo "Web
# application" — não precisa (nem deve ter) client secret, o fluxo é todo via ID token.
GOOGLE_CLIENT_ID=
