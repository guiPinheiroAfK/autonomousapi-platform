# Copie para .env.prod na VM (nunca commitar o .env.prod de verdade) e preencha.

# Neon — connection string DIRETA (sem "-pooler" no host), mesmo projeto/banco do
# core-api (schema public aqui, schema core lá — ver services/core-api/.env.prod.example).
GEO_DB_URL=postgresql+psycopg://neondb_owner:<senha>@<seu-endpoint>.<região>.aws.neon.tech/neondb?sslmode=require

# Mesmo valor usado em core-api/.env.prod (GEO_SERVICE_TOKEN) — é o segredo
# compartilhado que autentica o core-api contra este serviço interno.
GEO_SERVICE_TOKEN=

GEO_GPS_RETENTION_DAYS=30
GEO_ROAD_READINESS_RECALC_INTERVAL_MINUTES=5
