            "name": "to_lat",
            "required": true,
            "schema": {
              "maximum": 90.0,
              "minimum": -90.0,
              "title": "To Lat",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "to_lon",
            "required": true,
            "schema": {
              "maximum": 180.0,
              "minimum": -180.0,
              "title": "To Lon",
              "type": "number"
            }
          },
