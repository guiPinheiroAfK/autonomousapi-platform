                  "items": {
                    "$ref": "#/components/schemas/PlaceOut"
                  },
                  "title": "Response Geocode Internal V1 Geocode Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
