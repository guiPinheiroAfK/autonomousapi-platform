  "info": {
    "description": "Serviço geoespacial interno (GPS, rotas, prontidão viária). Não exposto à internet pública — só o core-api chama (spec 01).",
    "title": "geo-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "Liveness sem token, para orquestradores (não expõe nada sensível).",
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Root  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root",
        "tags": [
          "meta"
        ]
      }
    },
    "/internal/v1/charging-stations": {
      "get": {
        "description": "Lista estações com o status mais recente de cada uma (spec 06, item 1). RNF011: uma\nestação sem status observado recentemente (provedor nunca sincronizou, ou está fora\ndo ar há tempo) aparece com status \"DESCONHECIDO\" em vez de ser omitida ou quebrar a\nresposta — a tela do usuário nunca vê erro por causa disso.",
        "operationId": "listar_estacoes_recarga_internal_v1_charging_stations_get",
        "parameters": [
          {
            "in": "query",
            "name": "lat",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 90.0,
                  "minimum": -90.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lat"
            }
          },
          {
            "in": "query",
            "name": "lon",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 180.0,
                  "minimum": -180.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lon"
            }
          },
          {
            "in": "query",
            "name": "radius_km",
            "required": false,
            "schema": {
              "default": 20.0,
              "exclusiveMinimum": 0.0,
              "title": "Radius Km",
              "type": "number"
            }
          },
          {
            "in": "header",
            "name": "X-Service-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Service-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChargingStationsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Listar Estacoes Recarga",
        "tags": [
          "internal"
        ]
      }
    },
