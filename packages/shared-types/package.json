{
  "name": "@autonomousapi/shared-types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core-api": "./src/generated/core-api.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../contracts/internal/core-api.openapi.json -o ./src/generated/core-api.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.3.0",
    "typescript": "^5.5.4"
  }
}
